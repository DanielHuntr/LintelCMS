{
  "name": "example-app-node",
  "version": "0.0.0",
  "private": true,
  "description": "A reference Lintel app in plain Node: a publishing log with a page, a widget, an editor panel and settings.",
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lintel/app-bridge": "workspace:*"
  },
  "devDependencies": {
    "@lintel/core": "workspace:*",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
