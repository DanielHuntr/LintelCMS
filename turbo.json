{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "API_PORT",
        "ADMIN_ORIGIN",
        "NODE_ENV",
        "SITE_PORT",
        "SITE_PUBLIC_URL",
        "SITE_ENABLED"
      ]
    }
  }
}
