{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["TEST_DATABASE_URL"],
      "passThroughEnv": ["PLAYWRIGHT_BROWSERS_PATH"]
    },
    "dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "API_PORT",
        "ADMIN_ORIGIN",
        "NODE_ENV",
        "SITE_PORT",
        "SITE_PUBLIC_URL",
        "SITE_ENABLED"
      ]
    },
    "@lintel/admin#dev": {
      "dependsOn": ["@lintel/builder#build"],
      "cache": false,
      "persistent": true
    }
  }
}
