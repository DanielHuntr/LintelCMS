{
  "name": "lintel",
  "version": "1.0.0-rc.1",
  "private": true,
  "type": "module",
  "description": "Lintel: a self-hosted CMS with a visual builder, animation studio and commerce.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev --filter=!starter-nextjs --filter=!@lintel/docs",
    "docs:dev": "pnpm --filter @lintel/docs dev",
    "lintel": "pnpm --silent --filter @lintel/cli lintel",
    "create-admin": "pnpm --silent --filter @lintel/cli lintel create-admin",
    "reset-password": "pnpm --silent --filter @lintel/core reset-password",
    "db:migrate": "pnpm --silent --filter @lintel/core db:migrate",
    "media:move-to-s3": "pnpm --silent --filter @lintel/core media:move-to-s3",
    "send-test-email": "pnpm --silent --filter @lintel/core send-test-email",
    "lintel": "pnpm --silent --filter @lintel/core lintel",
    "build": "turbo run build",
    "start": "pnpm --filter @lintel/core start",
    "build:hosting": "turbo run build --filter=@lintel/core... --filter=@lintel/admin && pnpm --filter @lintel/core build:hosting",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint packages starters examples eslint.config.js",
    "format": "prettier --write packages starters examples docs brand .github \"*.{js,json,md,yml,yaml}\"",
    "format:check": "prettier --check packages starters examples docs brand .github \"*.{js,json,md,yml,yaml}\"",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@lintel/plugin-example-bookings": "workspace:*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
