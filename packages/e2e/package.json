  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@lintel/core": "workspace:*",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
