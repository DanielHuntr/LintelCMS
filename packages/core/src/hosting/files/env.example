# Lintel's settings. Most hosts have a screen for these (in cPanel: Setup Node.js App,
# edit the app, Environment variables), which is the easiest place to set them. Or copy
# this file to .env in the same folder and fill it in. Restart the app after a change.

# Your site's address, with https:// (required).
PUBLIC_URL=

# Leave empty to use the built-in database (nothing to set up), or choose Postgres in the
# setup wizard. Set it only to fix the database here instead:
# DATABASE_URL=postgres://user:password@localhost:5432/lintel
DATABASE_URL=

# Where Lintel keeps its database, uploads and settings. Defaults to .lintel in this folder.
# LINTEL_FOLDER=

# The secret for the cron job. Leave empty and Lintel makes one: run `npm run cron-line`
# (cPanel: Run JS script, then cron-line) to see the line for the Cron Jobs screen.
# CRON_SECRET=

# Email: see the environment variables guide for every option.
# EMAIL_DRIVER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
