{
  "name": "@lintel/core",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Lintel's API server: content model, entries, users and permissions.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/roles/permissions.d.ts",
      "development": "./src/roles/permissions.ts",
      "default": "./dist/roles/permissions.js"
    },
    "./password-strength": {
      "types": "./dist/auth/password-strength.d.ts",
      "development": "./src/auth/password-strength.ts",
      "default": "./dist/auth/password-strength.js"
    },
    "./site-presets": {
      "types": "./dist/setup/site-presets.d.ts",
      "development": "./src/setup/site-presets.ts",
      "default": "./dist/setup/site-presets.js"
    },
    "./media-crop": {
      "types": "./dist/media/focal-crop.d.ts",
      "development": "./src/media/focal-crop.ts",
      "default": "./dist/media/focal-crop.js"
    },
    "./content-model": {
      "types": "./dist/content-model-sync/content-model.d.ts",
      "development": "./src/content-model-sync/content-model.ts",
      "default": "./dist/content-model-sync/content-model.js"
    },
    "./data-tools": {
      "types": "./dist/data-tools.d.ts",
      "development": "./src/data-tools.ts",
      "default": "./dist/data-tools.js"
    },
    "./seo-titles": {
      "types": "./dist/seo/seo-titles.d.ts",
      "development": "./src/seo/seo-titles.ts",
      "default": "./dist/seo/seo-titles.js"
    },
    "./plugin": {
      "types": "./dist/plugins/plugin-api.d.ts",
      "development": "./src/plugins/plugin-api.ts",
      "default": "./dist/plugins/plugin-api.js"
    },
    "./plugin-testing": {
      "types": "./dist/plugins/plugin-testing.d.ts",
      "development": "./src/plugins/plugin-testing.ts",
      "default": "./dist/plugins/plugin-testing.js"
    },
    "./accent-colours": {
      "types": "./dist/branding/accent-colours.d.ts",
      "development": "./src/branding/accent-colours.ts",
      "default": "./dist/branding/accent-colours.js"
    },
    "./rich-text-picture": {
      "types": "./dist/fieldtypes/rich-text-picture.d.ts",
      "development": "./src/fieldtypes/rich-text-picture.ts",
      "default": "./dist/fieldtypes/rich-text-picture.js"
    },
    "./video-addresses": {
      "types": "./dist/fieldtypes/video-addresses.d.ts",
      "development": "./src/fieldtypes/video-addresses.ts",
      "default": "./dist/fieldtypes/video-addresses.js"
    },
    "./updates": {
      "types": "./dist/updates/command-line-updates.d.ts",
      "development": "./src/updates/command-line-updates.ts",
      "default": "./dist/updates/command-line-updates.js"
    },
    "./content-model-commands": {
      "types": "./dist/content-model-sync/model-commands.d.ts",
      "development": "./src/content-model-sync/model-commands.ts",
      "default": "./dist/content-model-sync/model-commands.js"
    },
    "./liquid-editor-commands": {
      "types": "./dist/liquid-editor-support/liquid-editor-commands.d.ts",
      "development": "./src/liquid-editor-support/liquid-editor-commands.ts",
      "default": "./dist/liquid-editor-support/liquid-editor-commands.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --tsconfig tsconfig.dev.json --conditions=development --env-file=development.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "reset-password": "tsx src/scripts/reset-password.ts",
    "model": "tsx src/scripts/model.ts",
    "media:move-to-s3": "tsx src/scripts/move-media-to-s3.ts",
    "send-test-email": "tsx src/scripts/send-test-email.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/s3-request-presigner": "^3.1161.0",
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/compress": "^9.3.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.8",
    "@lintel/builder": "workspace:*",
    "@lintel/builder-model": "workspace:*",
    "@lintel/field-conditions": "workspace:*",
    "@lintel/motion": "workspace:*",
    "@lintel/site-components": "workspace:*",
    "@simplewebauthn/server": "^14.0.3",
    "@tiptap/core": "^3.32.2",
    "@tiptap/html": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "dompurify": "^3.4.17",
    "drizzle-orm": "^0.45.4",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.7",
    "file-type": "^22.3.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^6.0.1",
    "jiti": "^2.7.0",
    "jsdom": "^30.1.3",
    "liquidjs": "^10.30.1",
    "markdown-it": "^14.3.3",
    "node-llama-cpp": "3.22.2",
    "nodemailer": "^10.3.1",
    "postgres": "^4.0.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "yaml": "^2.9.1",
    "yauzl": "^3.4.0",
    "yazl": "^3.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
