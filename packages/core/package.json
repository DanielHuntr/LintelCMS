{
  "name": "@lintel/core",
  "version": "0.0.0",
  "private": true,
  "description": "Lintel's API server: content model, entries, users and permissions.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/roles/permissions.d.ts",
      "development": "./src/roles/permissions.ts",
      "default": "./dist/roles/permissions.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/rate-limit": "^11.2.1",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "postgres": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
