{
  "name": "@lintel/core",
  "version": "0.0.0",
  "private": true,
  "description": "Lintel's API server: content model, entries, users and permissions.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./permissions": {
      "types": "./dist/roles/permissions.d.ts",
      "development": "./src/roles/permissions.ts",
      "default": "./dist/roles/permissions.js"
    },
    "./media-crop": {
      "types": "./dist/media/focal-crop.d.ts",
      "development": "./src/media/focal-crop.ts",
      "default": "./dist/media/focal-crop.js"
    },
    "./seo-titles": {
      "types": "./dist/seo/seo-titles.d.ts",
      "development": "./src/seo/seo-titles.ts",
      "default": "./dist/seo/seo-titles.js"
    }
  },
  "scripts": {
    "dev": "tsx watch --env-file=development.env src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "create-admin": "tsx src/scripts/create-admin.ts",
    "reset-password": "tsx src/scripts/reset-password.ts"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@fastify/cookie": "^11.1.5",
    "@fastify/cors": "^11.3.1",
    "@fastify/multipart": "^10.1.6",
    "@fastify/rate-limit": "^11.2.1",
    "@lintel/builder-model": "workspace:*",
    "@tiptap/core": "^3.32.2",
    "@tiptap/html": "^3.32.2",
    "@tiptap/pm": "^3.32.2",
    "@tiptap/starter-kit": "^3.32.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.7",
    "file-type": "^22.3.0",
    "graphql": "^16.14.2",
    "graphql-yoga": "^6.0.1",
    "markdown-it": "^14.3.3",
    "postgres": "^4.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/node": "^26.6.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
