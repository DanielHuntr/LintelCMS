{
  "name": "@lintel/motion",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "Lintel's animation runtime: plays JSON animation specs with the Web Animations API, and runs the Effects library's lazily loaded modules.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/spec/motion.schema.d.ts",
      "development": "./src/spec/motion.schema.ts",
      "default": "./dist/spec/motion.schema.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "development": "./src/presets/index.ts",
      "default": "./dist/presets/index.js"
    },
    "./site-runtime.js": "./dist/site-runtime.js",
    "./effects": {
      "types": "./dist/effects-catalogue/index.d.ts",
      "development": "./src/effects-catalogue/index.ts",
      "default": "./dist/effects-catalogue/index.js"
    },
    "./effect-modules/*": "./dist/effect-modules/*",
    "./model-poster": {
      "types": "./dist/effects/model/model-poster.d.ts",
      "development": "./src/effects/model/model-poster.ts",
      "default": "./dist/effects/model/model-poster.js"
    },
    "./sample-models/*": "./sample-models/*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-site-runtime.mjs && node scripts/bundle-effect-modules.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:unit": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "measure:effects": "node scripts/measure-effect-modules.mjs && prettier --write src/effects-catalogue/module-sizes.ts"
  },
  "dependencies": {
    "motion": "^14.9.0",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/three": "^0.187.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
