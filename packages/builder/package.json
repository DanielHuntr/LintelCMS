{
  "name": "@lintel/builder",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "The visual page builder the admin uses, and the renderer that turns a page design into HTML and CSS.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./render": {
      "types": "./dist/render/index.d.ts",
      "development": "./src/render/index.ts",
      "default": "./dist/render/index.js"
    },
    "./strings": {
      "types": "./dist/i18n/builder-strings.d.ts",
      "development": "./src/i18n/builder-strings.ts",
      "default": "./dist/i18n/builder-strings.js"
    },
    "./canvas-frame": {
      "types": "./dist/canvas/canvas-frame-script.d.ts",
      "development": "./src/canvas/canvas-frame-script.ts",
      "default": "./dist/canvas/canvas-frame-script.js"
    },
    "./site-shop-api": {
      "types": "./dist/site-behaviours/shop-api.d.ts",
      "development": "./src/site-behaviours/shop-api.ts",
      "default": "./dist/site-behaviours/shop-api.js"
    },
    "./site-behaviours.js": "./dist/site-behaviours.js",
    "./cookie-notice.js": "./dist/cookie-notice.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-site-behaviours.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  },
  "dependencies": {
    "@lintel/builder-model": "workspace:*",
    "@lintel/motion": "workspace:*",
    "@lintel/motion-editor": "workspace:*",
    "@lintel/site-components": "workspace:*",
    "lucide-react": "^1.66.0"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.3",
    "playwright": "1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
