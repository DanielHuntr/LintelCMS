{
  "name": "@lintel/cli",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "The lintel command: backups, moving sites, imports and checks, from the terminal.",
  "type": "module",
  "bin": {
    "lintel": "./dist/main.js"
  },
  "scripts": {
    "lintel": "tsx --conditions=development src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@lintel/core": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  }
}
