{
  "name": "@lintel/field-conditions",
  "version": "0.0.0",
  "private": true,
  "description": "Rules that show or hide a field depending on other fields' values, checked the same way by the admin and the server.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "development": "./src/index.ts",
      "default": "./dist/index.js"
    }
