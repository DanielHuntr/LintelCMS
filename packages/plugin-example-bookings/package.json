{
  "name": "@lintel/plugin-example-bookings",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "An example Lintel plugin: appointments, and the people who made them.",
  "type": "module",
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "development": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./admin": "./src/admin/index.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.admin.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@lintel/admin": "*",
    "@lintel/core": "*",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@lintel/admin": "workspace:*",
    "@lintel/core": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
