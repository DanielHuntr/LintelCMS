{
  "name": "@lintel/plugin-example-bookings",
  "version": "1.0.0-rc.1",
  "private": true,
  "description": "An example Lintel plugin: appointments, and the people who made them.",
  "type": "module",
  "lintel-addon": {
    "id": "bookings",
    "lintel": ">=1.0.0-rc.1",
    "server": "dist/addon/server.js",
    "admin": "dist/addon/admin.js",
    "tables": [
      {
        "name": "bookings",
        "purpose": "Each appointment: who, when and for how long.",
        "columns": [
          {
            "name": "customer_name",
            "purpose": "Who booked.",
            "personalData": true
          },
          {
            "name": "customer_email",
            "purpose": "How to reach them.",
            "personalData": true
          },
          {
            "name": "starts_at",
            "purpose": "When it starts."
          },
          {
            "name": "duration_minutes",
            "purpose": "How long it lasts."
          },
          {
            "name": "notes",
            "purpose": "Anything they or you added.",
            "personalData": true
          }
        ]
      }
    ]
  },
  "files": [
    "dist",
    "README.md",
    "migrations",
    "migrations-mysql"
  ],
  "exports": {
    "./server": {
      "types": "./dist/server/index.d.ts",
      "development": "./src/server/index.ts",
      "default": "./dist/server/index.js"
    },
    "./admin": "./src/admin/index.tsx"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.admin.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:generate:mysql": "drizzle-kit generate --config drizzle.mysql.config.ts",
    "build:addon": "tsx --conditions=development ../cli/src/main.ts addons build"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@lintel/admin": "*",
    "@lintel/core": "*",
    "@tanstack/react-query": "^5.105.0",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1"
  },
  "peerDependenciesMeta": {
    "@lintel/admin": {
      "optional": true
    },
    "@lintel/core": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "lucide-react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@lintel/admin": "workspace:*",
    "@lintel/core": "workspace:*",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "lucide-react": "^1.66.0",
    "react": "^19.3.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
