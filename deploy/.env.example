# Settings for deploy/docker-compose.yml. Copy this file to deploy/.env and fill it in.
# Every setting is described in the docs: "Environment variables reference".

# ---- Required ----

# The domain people will visit. Its DNS "A" record must point at this server.
LINTEL_DOMAIN=cms.example.com

# The same address with https:// in front. Used in links, such as to uploaded files.
PUBLIC_URL=https://cms.example.com

# A long random password for the database. Make one with:  openssl rand -hex 24
# Use only letters and numbers, so it needs no special treatment in the database address.
POSTGRES_PASSWORD=

# ---- Optional ----

# Where the admin lives. Default: /admin
# ADMIN_PATH=/admin

# How much to log: error, warn, info (default) or debug.
# LOG_LEVEL=info

# ---- Uploaded files: kept in the lintel-uploads volume unless you use a bucket ----
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=auto
# S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SIGNED_URLS=false

# ---- Email: kept in an outbox and not sent until you choose a driver ----
# EMAIL_DRIVER=smtp
# EMAIL_FROM=Your Site <hello@example.com>
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=

# ---- One-click updates (opt-in, see "Updating Lintel" in the docs) ----
# Start compose with `--profile updater` too. The token is shared by Lintel and the
# updater: make one with  openssl rand -hex 32
# LINTEL_UPDATER_URL=http://lintel-updater:8080
# LINTEL_UPDATER_TOKEN=
# The repository's full path on this server, such as /home/ana/LintelCMS
# LINTEL_REPO_PATH=
