# Lintel works without a .env file: every setting below has a sensible default.
# Only create one (copy this file to .env) if you want to change something.
# A setting from your terminal's environment wins over the same setting in .env.

# Which Postgres database to use. Leave it out (or empty) to use the built-in database,
# or the one you picked on the setup screen in the browser.
# If the password contains #, @ or /, write them as %23, %40 and %2F. For example, the
# password "p@ss#1" becomes:  postgres://lintel:p%40ss%231@localhost:5432/lintel
# The line below matches `pnpm db:up` (Postgres in Docker, see docker-compose.yml).
# DATABASE_URL=postgres://lintel:lintel@localhost:5432/lintel

# The port the API listens on. Default: 4000.
# API_PORT=4000

# The address of the admin in your browser, which is allowed to call the API.
# Default: http://localhost:5173.
# ADMIN_ORIGIN=http://localhost:5173

# "development" lets the sign-in cookie work over plain http://localhost. `pnpm dev`
# already sets it, so only change it here if you know you need to. Default: production.
# NODE_ENV=development

# Lets webhooks go to localhost and private network addresses, for testing a receiver on
# your own computer. Leave it off on a real server. Default: false.
# WEBHOOKS_ALLOW_PRIVATE_ADDRESSES=true

# Behind a proxy (nginx, Caddy, a load balancer)? Set this so sign-in limits and logs see
# each visitor's own address: "true", the number of proxies, or their addresses. Leave it
# unset without a proxy, or anyone could claim to be any address. Default: unset.
# TRUST_PROXY=1
