# Copy this file to .env.local and change what you need.
# (.env.local is never committed, so secrets stay on your computer.)

# Where Lintel's API is running. `pnpm dev` in Lintel starts it on port 4000.
LINTEL_API_URL=http://localhost:4000

# Your site's name, shown in the header and the browser tab.
SITE_NAME=My Lintel site

# A long random password for /api/revalidate, which refreshes pages straight away.
# Leave it empty to switch that route off. Make one with: openssl rand -hex 32
REVALIDATE_SECRET=
